# Required
OPENAI_API_KEY=sk-proj-...

# Optional — override default models
# Realtime (GA only — uses /v1/realtime/client_secrets):
#   gpt-realtime          (GA, recommended baseline)
#   gpt-realtime-2        (latest, better instruction following)
OPENAI_REALTIME_MODEL=gpt-realtime-2

# Primary text model (Writing feedback + Coach chat):
#   gpt-5.5               (latest, best reasoning)
#   gpt-5.1               (older, faster)
#   gpt-4o-2024-08-06     (proven json_schema support)
OPENAI_TEXT_MODEL=gpt-5.5

# Fallback if primary rejects response_format json_schema on chat.completions
# (some gpt-5.x models route json_schema through the Responses API only).
OPENAI_TEXT_FALLBACK=gpt-4o-2024-08-06
